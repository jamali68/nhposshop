{
  "entities": {
    "ShopProfile": {
      "title": "Shop Profile",
      "description": "Multi-tenant shop profile owned by a verified shopkeeper",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_name": { "type": "string", "maxLength": 200 },
        "owner_name": { "type": "string", "maxLength": 100 },
        "owner_email": { "type": "string", "maxLength": 150 },
        "owner_uid": { "type": "string" },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "created_at": { "type": "string" }
      },
      "required": ["id", "shop_name", "owner_name", "owner_email", "owner_uid", "created_at"]
    },
    "StaffDirectory": {
      "title": "Staff Directory",
      "description": "Global index for staff credentials linking to tenant shop",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 50 },
        "password": { "type": "string", "maxLength": 100 },
        "shop_id": { "type": "string" },
        "role": { "type": "string", "enum": ["manager", "cashier", "salesman"] },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" }
      },
      "required": ["username", "password", "shop_id", "role", "name", "is_active"]
    },
    "DailyTransaction": {
      "title": "Daily Transaction",
      "description": "Daily shop cash flow record (cash in, cash out, counter bills, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "type": { "type": "string", "enum": ["opening", "in", "out", "bill_add", "payment"] },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "transaction_date": { "type": "string" },
        "created_by": { "type": "string" },
        "party_type": { "type": "string", "enum": ["customer", "wholesaler", "none"] },
        "bill_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "type", "amount", "description", "transaction_date", "created_by"]
    },
    "BackCashTransaction": {
      "title": "Back Cash Transaction",
      "description": "Owner back cash receiving or cash out record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "type": { "type": "string", "enum": ["receiving", "out"] },
        "amount": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "transaction_date": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "type", "amount", "note", "transaction_date", "created_by"]
    },
    "WholesalerBill": {
      "title": "Wholesaler Bill",
      "description": "Supplier / Wholesaler credit ledger account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "customer_name": { "type": "string", "maxLength": 200 },
        "phone_number": { "type": "string", "maxLength": 50 },
        "total_bill": { "type": "number" },
        "remaining_balance": { "type": "number" },
        "created_date": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "invoice_number": { "type": "string" }
      },
      "required": ["id", "customer_name", "total_bill", "remaining_balance", "created_date", "status"]
    },
    "CustomerBill": {
      "title": "Customer Bill",
      "description": "Customer Udhaar / credit ledger account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "customer_name": { "type": "string", "maxLength": 200 },
        "phone_number": { "type": "string", "maxLength": 50 },
        "total_bill": { "type": "number" },
        "remaining_balance": { "type": "number" },
        "created_date": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "invoice_number": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "customer_name", "total_bill", "remaining_balance", "created_date", "status"]
    },
    "EasyloadRecord": {
      "title": "Easyload Record",
      "description": "Daily mobile easyload sale & balance tracker per network",
      "type": "object",
      "properties": {
        "date_recorded": { "type": "string" },
        "shop_id": { "type": "string" },
        "jazz_opening": { "type": "number" },
        "jazz_purchase": { "type": "number" },
        "jazz_closing": { "type": "number" },
        "telenor_opening": { "type": "number" },
        "telenor_purchase": { "type": "number" },
        "telenor_closing": { "type": "number" },
        "zong_opening": { "type": "number" },
        "zong_purchase": { "type": "number" },
        "zong_closing": { "type": "number" },
        "ufone_opening": { "type": "number" },
        "ufone_purchase": { "type": "number" },
        "ufone_closing": { "type": "number" },
        "total_commission_earned": { "type": "number" }
      },
      "required": ["date_recorded"]
    },
    "BottleItem": {
      "title": "Bottle Item",
      "description": "Stock inventory item with purchase/sale prices and commission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "item_name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "total_stock": { "type": "number" },
        "unit_price": { "type": "number" },
        "commission_per_unit": { "type": "number" },
        "salesman_price": { "type": "number" }
      },
      "required": ["id", "item_name", "total_stock", "unit_price"]
    },
    "StockTransaction": {
      "title": "Stock Transaction",
      "description": "Stock movement transaction log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "item_id": { "type": "string" },
        "item_name": { "type": "string" },
        "user_name": { "type": "string" },
        "action_type": { "type": "string", "enum": ["add", "remove", "reverse"] },
        "quantity": { "type": "number" },
        "note": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "item_id", "quantity", "action_type", "created_at"]
    },
    "DeletedHistoryRecord": {
      "title": "Deleted History Record",
      "description": "Audit trash log of deleted transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "original_id": { "type": "string" },
        "source": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "transaction_date": { "type": "string" },
        "deleted_by": { "type": "string" },
        "deleted_at": { "type": "string" }
      },
      "required": ["id", "original_id", "source", "amount", "deleted_by", "deleted_at"]
    },
    "StaffAccount": {
      "title": "Staff Account",
      "description": "Staff member login accounts created by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shop_id": { "type": "string" },
        "username": { "type": "string", "maxLength": 50 },
        "password": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "manager", "cashier", "salesman", "user"] },
        "phone": { "type": "string", "maxLength": 50 },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "username", "password", "name", "role", "is_active"]
    },
    "AccountRegistry": {
      "title": "Account Registry",
      "description": "Global mapping of user emails to their permanent shop ID and profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "shop_id": { "type": "string" },
        "shop_name": { "type": "string", "maxLength": 200 },
        "owner_name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string" },
        "created_at": { "type": "string" },
        "last_login": { "type": "string" }
      },
      "required": ["email", "shop_id", "shop_name"]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": "ShopProfile",
      "description": "Multi-tenant shop profile"
    },
    "/shops/{shopId}/daily_transactions/{txId}": {
      "schema": "DailyTransaction",
      "description": "Tenant shop cash book transactions"
    },
    "/shops/{shopId}/back_cash_transactions/{txId}": {
      "schema": "BackCashTransaction",
      "description": "Tenant back cash transactions"
    },
    "/shops/{shopId}/wholesaler_bills/{billId}": {
      "schema": "WholesalerBill",
      "description": "Tenant supplier credit and ledger bills"
    },
    "/shops/{shopId}/customer_bills/{billId}": {
      "schema": "CustomerBill",
      "description": "Tenant customer khata credit accounts"
    },
    "/shops/{shopId}/easyload_records/{dateId}": {
      "schema": "EasyloadRecord",
      "description": "Tenant daily mobile easyload sale & balance per network"
    },
    "/shops/{shopId}/bottle_items/{itemId}": {
      "schema": "BottleItem",
      "description": "Tenant inventory and stock products"
    },
    "/shops/{shopId}/stock_transactions/{txId}": {
      "schema": "StockTransaction",
      "description": "Tenant stock transaction logs"
    },
    "/shops/{shopId}/deleted_history/{delId}": {
      "schema": "DeletedHistoryRecord",
      "description": "Tenant audit logs for deleted items"
    },
    "/shops/{shopId}/staff_accounts/{staffId}": {
      "schema": "StaffAccount",
      "description": "Tenant staff member accounts"
    },
    "/staff_directory/{username}": {
      "schema": "StaffDirectory",
      "description": "Global index for staff authentication"
    },
    "/account_registry/{emailKey}": {
      "schema": "AccountRegistry",
      "description": "Global permanent registry mapping email to shop profile"
    },
    "/users/{userId}": {
      "schema": "ShopProfile",
      "description": "User profile document"
    }
  }
}
